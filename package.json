{
  "name": "merge-cafe",
  "version": "1.0.0",
  "private": true,
  "description": "Merge Café – casual merge game (Android, iOS, Web)",
  "scripts": {
    "serve": "npx http-server www -p 8080 -c-1",
    "sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios",
    "web-zip": "node -e \"require('child_process').execSync('cd www && tar -a -c -f ../merge-cafe-web.zip *',{stdio:'inherit',shell:true})\""
  },
  "dependencies": {
    "@capacitor/core": "latest",
    "@capacitor/android": "latest",
    "@capacitor/ios": "latest",
    "@capacitor-community/admob": "latest",
    "appsflyer-capacitor-plugin": "latest",
    "@revenuecat/purchases-capacitor": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@capacitor/assets": "latest"
  }
}
